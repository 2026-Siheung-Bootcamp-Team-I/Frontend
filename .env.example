# API base URL. 비워두면 Vite dev proxy(/api -> API_PROXY_TARGET)를 탄다.
# 배포 시에만 백엔드 절대 주소를 넣는다. (예: https://api.edrdog.io/api)
VITE_API_BASE_URL=

# dev proxy 가 붙을 api-service 주소 (기본 http://localhost:8084)
API_PROXY_TARGET=http://localhost:8084

# 백엔드 ApiKeyFilter 가 요구하는 X-API-Key 값. 배포 시 백엔드 EDRDOG_API_KEY 와 반드시 같은 값이어야 한다.
# 다르면 온보딩의 enroll secret 조회(/tenant/enroll-secret)가 401 이 난다.
VITE_API_KEY=

# 온보딩의 fleetd 등록 안내에 넣을 Fleet 서버 주소. 화면 표시용이라 프론트가 직접 호출하지는 않는다.
# 비워두면 예시 주소(https://fleet.example.com)를 보여주고 관리자에게 받으라고 안내한다.
VITE_FLEET_URL=

# 엔드포인트에서 도달 가능한 api-service HTTPS 주소(osquery 플래그의 tls_hostname 에 들어갈 값).
# 미설정이면 온보딩 화면이 플레이스홀더를 보여준다.
VITE_OSQUERY_TLS_HOST=
