# API base URL. 비워두면 Vite dev proxy(/api -> API_PROXY_TARGET)를 탄다.
# 배포 시에만 백엔드 절대 주소를 넣는다. (예: https://api.edrdog.io/api)
VITE_API_BASE_URL=

# dev proxy 가 붙을 api-service 주소 (기본 http://localhost:8084)
API_PROXY_TARGET=http://localhost:8084

# 실제 조치(kill) responder-service base URL. 비워두면 Vite dev proxy(/responder-api -> RESPONDER_PROXY_TARGET).
# 배포 시 responder-service 절대 주소를 넣는다. (예: https://responder.edrdog.io)
VITE_RESPONDER_BASE_URL=

# dev proxy 가 붙을 responder-service 주소 (기본 http://localhost:8082)
RESPONDER_PROXY_TARGET=http://localhost:8082
